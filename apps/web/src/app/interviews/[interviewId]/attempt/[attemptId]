"use client";

import { useEffect, useState } from "react";
import { useParams, useRouter } from "next/navigation";

import {
  getQuestions,
  type InterviewQuestion,
} from "@/lib/interviews";

import { createAnswer } from "@/lib/answers";

export default function AttemptPage() {
  const params = useParams();
  const router = useRouter();

  const interviewId =
    params.interviewId as string;

  const attemptId =
    params.attemptId as string;

  const [questions, setQuestions] =
    useState<InterviewQuestion[]>([]);

  const [currentIndex, setCurrentIndex] =
    useState(0);

  const [answer, setAnswer] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [submitting, setSubmitting] =
    useState(false);

  const [error, setError] =
    useState("");

  useEffect(() => {
    const loadQuestions = async () => {
      try {
        setLoading(true);
        setError("");

        const result =
          await getQuestions(interviewId);

        setQuestions(
          result.data?.questions ?? []
        );
      } catch (err: unknown) {
        if (
          typeof err === "object" &&
          err !== null &&
          "response" in err
        ) {
          const response = (
            err as {
              response?: {
                data?: {
                  message?: string;
                };
              };
            }
          ).response;

          setError(
            response?.data?.message ??
              "Failed to load questions."
          );
        } else {
          setError(
            "Failed to load questions."
          );
        }
      } finally {
        setLoading(false);
      }
    };

    loadQuestions();
  }, [interviewId]);

  const currentQuestion =
    questions[currentIndex];

  const handleSubmitAnswer = async () => {
    if (!currentQuestion) {
      return;
    }

    if (!answer.trim()) {
      setError("Please provide an answer.");
      return;
    }

    try {
      setSubmitting(true);
      setError("");

      await createAnswer(
        interviewId,
        attemptId,
        {
          questionId: currentQuestion.id,
          answer: answer.trim(),
        }
      );

      if (
        currentIndex <
        questions.length - 1
      ) {
        setCurrentIndex(
          currentIndex + 1
        );

        setAnswer("");
      } else {
        router.push(
          `/interviews/${interviewId}/attempt/${attemptId}/complete`
        );
      }
    } catch (err: unknown) {
      if (
        typeof err === "object" &&
        err !== null &&
        "response" in err
      ) {
        const response = (
          err as {
            response?: {
              data?: {
                message?: string;
              };
            };
          }
        ).response;

        setError(
          response?.data?.message ??
            "Failed to submit answer."
        );
      } else {
        setError(
          "Failed to submit answer."
        );
      }
    } finally {
      setSubmitting(false);
    }
  };

  if (loading) {
    return (
      <main className="min-h-screen p-8">
        <div className="mx-auto max-w-3xl">
          <p className="text-gray-500">
            Loading interview...
          </p>
        </div>
      </main>
    );
  }

  if (questions.length === 0) {
    return (
      <main className="min-h-screen p-8">
        <div className="mx-auto max-w-3xl">
          <div className="rounded-xl border p-6">
            <h1 className="text-xl font-semibold">
              No questions found
            </h1>

            <button
              onClick={() =>
                router.push(
                  `/interviews/${interviewId}`
                )
              }
              className="mt-4 rounded-md bg-black px-4 py-2 text-white"
            >
              Back to Interview
            </button>
          </div>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen p-8">
      <div className="mx-auto max-w-3xl">

        <header className="mb-8">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">
                Interview
              </p>

              <h1 className="text-2xl font-bold">
                Question{" "}
                {currentIndex + 1}{" "}
                of {questions.length}
              </h1>
            </div>

            <span className="rounded-full border px-3 py-1 text-sm">
              {currentQuestion.type}
            </span>
          </div>

          <div className="mt-4 h-2 overflow-hidden rounded-full bg-gray-200">
            <div
              className="h-full bg-black transition-all"
              style={{
                width: `${
                  ((currentIndex + 1) /
                    questions.length) *
                  100
                }%`,
              }}
            />
          </div>
        </header>

        {error && (
          <div className="mb-6 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-600">
            {error}
          </div>
        )}

        <section className="rounded-xl border p-6">

          <h2 className="text-xl font-semibold leading-relaxed">
            {currentQuestion.question}
          </h2>

          {currentQuestion.type ===
            "MCQ" &&
            currentQuestion.options && (
              <div className="mt-6 space-y-3">
                {currentQuestion.options.map(
                  (option, index) => {
                    const letter =
                      String.fromCharCode(
                        65 + index
                      );

                    const selected =
                      answer === option;

                    return (
                      <button
                        key={index}
                        type="button"
                        onClick={() =>
                          setAnswer(option)
                        }
                        className={`w-full rounded-lg border p-4 text-left transition ${
                          selected
                            ? "border-black bg-gray-100"
                            : "hover:bg-gray-50"
                        }`}
                      >
                        <span className="mr-3 font-semibold">
                          {letter}.
                        </span>

                        {option}
                      </button>
                    );
                  }
                )}
              </div>
            )}

          {currentQuestion.type ===
            "SUBJECTIVE" && (
              <textarea
                value={answer}
                onChange={(e) =>
                  setAnswer(e.target.value)
                }
                placeholder="Write your answer..."
                rows={8}
                className="mt-6 w-full rounded-lg border p-4 outline-none focus:ring-2"
              />
            )}

          {currentQuestion.type ===
            "CODING" && (
              <textarea
                value={answer}
                onChange={(e) =>
                  setAnswer(e.target.value)
                }
                placeholder="Write your solution..."
                rows={14}
                className="mt-6 w-full rounded-lg border p-4 font-mono text-sm outline-none focus:ring-2"
              />
            )}

          <div className="mt-6 flex justify-end">
            <button
              type="button"
              onClick={handleSubmitAnswer}
              disabled={submitting}
              className="rounded-md bg-black px-6 py-3 font-medium text-white disabled:opacity-50"
            >
              {submitting
                ? "Submitting..."
                : currentIndex ===
                    questions.length - 1
                  ? "Submit & Finish"
                  : "Submit Answer →"}
            </button>
          </div>

        </section>

      </div>
    </main>
  );
}